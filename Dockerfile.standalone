# Dedicated CocinaCore stack. Historical PawTech Dockerfile remains unchanged.
FROM node:22.22.3-alpine@sha256:e58326d0d441090181ac150dc2078d3e2cf6a0d42e809aebba3ef5880935ffdd AS base
RUN apk add --no-cache libc6-compat \
    && addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 --ingroup nodejs nextjs
WORKDIR /app

FROM base AS deps
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

FROM base AS builder
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /app/node_modules ./node_modules
COPY frontend/package.json frontend/package-lock.json frontend/next.config.ts frontend/tsconfig.json frontend/postcss.config.mjs frontend/instrumentation.ts frontend/middleware.ts frontend/sentry.client.config.ts frontend/sentry.edge.config.ts frontend/sentry.server.config.ts ./
COPY frontend/src ./src
# TypeScript checks an integration test that imports this attestation helper.
COPY frontend/scripts/activated-capabilities-attestation.js ./scripts/
COPY frontend/public ./public
# TypeScript includes tests importing these four E2E helpers.
COPY frontend/e2e/database-target.ts frontend/e2e/standalone-server-env.ts ./e2e/
COPY frontend/e2e/reporters/production-safety-reporter.ts ./e2e/reporters/
COPY frontend/e2e/fixtures/family-week-cleanup-contract.ts ./e2e/fixtures/
RUN npm run build

# Operational dependencies are intentionally absent from the application image.
FROM base AS ops-deps
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --omit=dev

FROM base AS operations
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
RUN apk add --no-cache postgresql16-client
WORKDIR /app/frontend
COPY --from=ops-deps /app/node_modules ./node_modules
COPY frontend/package.json ./package.json
COPY frontend/scripts/activate-020-capabilities.js frontend/scripts/activated-capabilities-attestation.js frontend/scripts/activated-capabilities-attestation.sql frontend/scripts/activated-capabilities-021-attestation.sql frontend/scripts/activated-capabilities-022-occurrences.sql frontend/scripts/activated-capabilities-023-retention.sql frontend/scripts/activated-capabilities-024-first-admin.sql frontend/scripts/activated-capabilities-024-inventory.sql frontend/scripts/bootstrap-first-platform-admin.js frontend/scripts/bootstrap-owner.js frontend/scripts/legacy-017-attestation.js frontend/scripts/legacy-017-database-attestation.js frontend/scripts/migration-baseline.js frontend/scripts/migration-ledger-contract.js frontend/scripts/prepared-capabilities-attestation.js frontend/scripts/prepared-capabilities-attestation.sql frontend/scripts/prepared-capabilities-contract.js frontend/scripts/provision-database.js frontend/scripts/run-migrations.js ./scripts/
COPY db/migrations /app/db/migrations
COPY scripts/provision-runtime-role.sql scripts/provision-auth-role.sql scripts/provision-020-inert-capabilities.sql scripts/provision-first-platform-admin-roles.sql scripts/provision-signup-bootstrap-roles.sql scripts/provision-owner-metrics-role.sql scripts/provision-global-writer-role.sql /app/scripts/
COPY scripts/rls-candidates/020e-a1-inert-capability-guard.sql /app/scripts/rls-candidates/
USER nextjs
# Explicit commands required: no implicit provisioning or migration at startup.
CMD ["node", "-e", "console.error('Specify an explicit approved operations command'); process.exit(1)"]

FROM base AS runtime
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
RUN mkdir -p /app/uploads /app/.next/cache \
    && chown -R nextjs:nodejs /app/uploads /app/.next
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
USER nextjs
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/api/health',{signal:AbortSignal.timeout(4000)}).then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "server.js"]
