# Local development environment for CocinaCore
# Copy this file to .env.local and replace all placeholders.
# Never commit real secrets.

DATABASE_URL=postgresql://cocinacore_user:cocinacore_password@localhost:5433/cocinacore_local_db
REDIS_URL=redis://localhost:6379
GEMINI_API_KEY=CHANGE_ME
AUTH_SECRET=CHANGE_ME

# Storage: only 'local' is implemented. Files are persisted under LOCAL_UPLOAD_DIR.
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./uploads
