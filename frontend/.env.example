# ┌─────────────────────────────────────────────────────────────────┐
# │ CocinaCore — Environment Variables                              │
# │ Copy to .env.local and fill real values.                        │
# │ This project NO LONGER REQUIRES Supabase for runtime.           │
# └─────────────────────────────────────────────────────────────────┘

# ── PostgreSQL (direct connection) ─────────────────────────────────
# Required. Server-only, never expose to the browser.
DATABASE_URL=postgresql://cocinacore_user:cocinacore_password@localhost:5433/cocinacore_local_db?schema=public

# ── Redis (optional, falls back to in-memory) ──────────────────────
REDIS_URL=redis://localhost:6379

# ── AI Providers ───────────────────────────────────────────────────
# Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=CHANGE_ME

# Gemini model for recipe generation
GEMINI_MODEL=gemini-2.5-flash

# Gemini model for embeddings
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Embedding vector dimensions (keep 1536 for HNSW index compatibility)
EMBEDDING_DIMENSIONS=1536

# Optional secondary AI provider (OpenRouter or equivalent)
AI_PROVIDER=opencode-go
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=CHANGE_ME
AI_MODEL=CHANGE_ME

# ── Auth Security ──────────────────────────────────────────────────
# Required. Used to sign session cookies. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=CHANGE_ME

# Session cookie name
AUTH_COOKIE_NAME=cocinacore_session

# Session TTL in seconds (default: 7 days)
AUTH_SESSION_TTL_SECONDS=604800

# MFA enforcement is intentionally disabled in this migration phase.
AUTH_ENFORCE_MFA=false

# ── Storage ────────────────────────────────────────────────────────
# Local file uploads directory. Used when S3 is not configured.
LOCAL_UPLOAD_DIR=./uploads

# Optional S3-compatible object storage (e.g. Contabo, MinIO, AWS S3)
S3_ENDPOINT=CHANGE_ME
S3_BUCKET=CHANGE_ME
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_REGION=auto
S3_FORCE_PATH_STYLE=true

# ── Public URLs ────────────────────────────────────────────────────
# Public URL of the running app (server-side redirects, emails, etc.)
APP_PUBLIC_URL=http://localhost:3000

# Public URL exposed to the browser
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Sentry ─────────────────────────────────────────────────────────
# Optional. Leave empty to disable Sentry.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Environment ────────────────────────────────────────────────────
NODE_ENV=development
