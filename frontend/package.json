{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "analyze": "ANALYZE=true next build --webpack",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:migrate": "node scripts/run-migrations.js",
    "db:migrate:dry": "node scripts/run-migrations.js --dry-run",
    "db:bootstrap": "node scripts/bootstrap-owner.js"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.56.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.77.7",
    "framer-motion": "^12.40.0",
    "ioredis": "^5.11.0",
    "jose": "^5.9.6",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "pdfjs-dist": "^5.7.284",
    "pg": "^8.13.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tesseract.js": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.7",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.11.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.8",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.7"
