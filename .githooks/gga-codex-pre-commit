#!/usr/bin/env bash
set -euo pipefail

attempts="${GGA_CODEX_ATTEMPTS:-1}"
timeout="${GGA_TIMEOUT:-600}"

if ! command -v codex >/dev/null 2>&1; then
  echo "Codex executable is unavailable; refusing to continue" >&2
  exit 1
fi
if ! ledger_path="${GGA_CODEX_LEDGER:-$(git rev-parse --git-path gga-codex-attempts.log 2>/dev/null)}"; then
  echo "Unable to resolve the Codex GGA ledger path; refusing to continue" >&2
  exit 1
fi
if [[ -z "$ledger_path" ]]; then
  echo "Codex GGA ledger path is empty; refusing to continue" >&2
  exit 1
fi

if [[ "$attempts" != "1" ]]; then
  echo "GGA Codex requires exactly one authorized attempt; refusing to continue" >&2
  exit 1
fi
if [[ ! "$timeout" =~ ^[1-9][0-9]*$ ]]; then
  echo "GGA Codex timeout must be a positive integer; refusing to continue" >&2
  exit 1
fi
if (( timeout > 600 )); then
  echo "GGA Codex timeout must be at most 600 seconds; refusing to continue" >&2
  exit 1
fi

current_head="$(git rev-parse HEAD)"
current_branch="$(git branch --show-current)"
current_tree="$(git write-tree)"
if [[ ! -f "$ledger_path" ]] || ! awk -v head="$current_head" -v branch="$current_branch" -v tree="$current_tree" '
  {
    if (index($0, "status=AUTHORIZED") &&
        index($0, "provider=codex") &&
        index($0, "authorized_attempts=1") &&
        index($0, "timeout=600") &&
        index($0, "head=" head) &&
        index($0, "branch=" branch) &&
        index($0, "tree=" tree)) {
      authorization_line = NR
    }
    if (authorization_line && NR > authorization_line &&
        index($0, "provider=codex") &&
        index($0, "attempt=1") &&
        index($0, "result=")) {
      consumed = 1
    }
  }
  END {
    exit authorization_line && !consumed ? 0 : 1
  }
' "$ledger_path"; then
  echo "No unused one-attempt authorization matches this candidate; refusing to continue" >&2
  exit 1
fi

record_attempt() {
  local attempt="$1"
  local result="$2"
  printf '%s provider=codex attempt=%s result=%s head=%s branch=%s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    "$attempt" "$result" "$(git rev-parse HEAD)" "$(git branch --show-current)" >> "$ledger_path"
}

echo "GGA Codex attempt 1/1 provider=codex timeout=${timeout}s model=cli-default reasoning=cli-default"
if GGA_PROVIDER=codex GGA_TIMEOUT="$timeout" gga run --no-cache; then
  record_attempt 1 PASS
  echo "GGA Codex PASS"
  exit 0
fi
record_attempt 1 FAIL
echo "GGA Codex BLOCKED: no approved review result" >&2
exit 1
